APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://partner:partner@db:5432/partner
APPLICATION_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
MODEL_MODE=deterministic
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=45
ARMORIQ_API_KEY=
ARMORIQ_BASE_URL=https://api.armoriq.ai
ARMORIQ_MODE=mock
ARMORIQ_USER_ID=partner-agent-service
ARMORIQ_AGENT_ID=armoriq-partner-agent
ARMORIQ_OPERATOR_EMAIL=
ARMORIQ_LOCAL_TOOL_NAMESPACE=partner-agent-local
MCP_SERVER_URL=https://replace-with-public-mcp-host.example/mcp
MCP_SERVER_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
OPTIONAL_SEARCH_PROVIDER_KEYS=
GCP_PROJECT_ID=
GCP_REGION=us-east1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Autonomous execution is still bounded by ArmorIQ policies and mission delegation.
AUTONOMOUS_EXECUTION_ENABLED=true
BACKGROUND_WORKER_INTERVAL_SECONDS=3600
BACKGROUND_WORKER_RUN_ONCE=false
ARMORIQ_FAIL_CLOSED=true
