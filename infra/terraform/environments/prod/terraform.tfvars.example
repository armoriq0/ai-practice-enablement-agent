project_id       = "your-gcp-project"
backend_image    = "us-east1-docker.pkg.dev/your-gcp-project/armoriq-partner/backend:release-sha"
frontend_image   = "us-east1-docker.pkg.dev/your-gcp-project/armoriq-partner/frontend:release-sha"
operator_members = ["group:partner-operators@example.com"]
enable_schedulers = true
daily_discovery_schedule = "0 6 * * *" # 6 AM America/New_York
